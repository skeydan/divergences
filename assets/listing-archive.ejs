<%
// Archive: every post, grouped by year, one line each.
const iso = (d) => String(d || '').slice(0, 10);
const yearOf = (d) => iso(d).slice(0, 4) || 'undated';
const langOf = (item) => String(item.lang || 'en').slice(0, 2).toLowerCase();
const years = [];
for (const item of items) {
  const y = yearOf(item.date);
  if (!years.length || years[years.length - 1].y !== y) years.push({ y, items: [] });
  years[years.length - 1].items.push(item);
}
%>

```{=html}
<div class="dv-archive">
<% for (const g of years) { %>
<section class="dv-archive-year" aria-labelledby="y<%= g.y %>">
  <h2 class="no-anchor" id="y<%= g.y %>"><%= g.y %> <span class="dv-archive-n" data-i18n="nposts" data-n="<%= g.items.length %>"><%= g.items.length %> post<%= g.items.length === 1 ? "" : "s" %></span></h2>
  <ol>
  <% for (const it of g.items) { %>
    <li data-lang="<%- langOf(it) %>"><time datetime="<%= iso(it.date) %>" data-fmt="daymonth"><%= iso(it.date).slice(5) %></time><a href="<%- it.path %>"><%= it.title %></a><span class="dv-langbadge" data-lang="<%- langOf(it) %>"><%- langOf(it) %></span></li>
  <% } %>
  </ol>
</section>
<% } %>
</div>
```
