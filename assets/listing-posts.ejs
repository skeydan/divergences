<% } %>
    <% if (item.categories && item.categories.length) { %>
    <div class="dv-item-cats">
      <% for (const c of item.categories) { %><a class="dv-cat" data-cat="<%- slug(c) %>" href="<%- root %>category/<%- slug(c) %>.html"><%= esc(c) %></a><% } %>
    </div>
    <% } %>
  </div>
  <% if (item.image) { %>
  <a class="dv-item-thumb" href="<%- item.path %>" tabindex="-1" aria-hidden="true"><img src="<%- item.image %>" alt="" loading="lazy" decoding="async"></a>
  <% } %>
</li>
<% } %>
</ol>
